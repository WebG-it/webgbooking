<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            inputmode="search"
            label="COM_WEBGBOOKING_SEARCH_LABEL"
            description="COM_WEBGBOOKING_SEARCH_DESC"
            hint="COM_WEBGBOOKING_SEARCH_HINT"
        />
        <field
            name="status"
            type="list"
            label="COM_WEBGBOOKING_COL_STATUS"
            onchange="this.form.submit();"
        >
            <option value="">COM_WEBGBOOKING_FILTER_STATUS_ALL</option>
            <option value="pending">COM_WEBGBOOKING_STATUS_PENDING</option>
            <option value="confirmed">COM_WEBGBOOKING_STATUS_CONFIRMED</option>
            <option value="completed">COM_WEBGBOOKING_STATUS_COMPLETED</option>
            <option value="no-show">COM_WEBGBOOKING_STATUS_NOSHOW</option>
            <option value="cancelled">COM_WEBGBOOKING_STATUS_CANCELLED</option>
            <option value="awaiting_payment">COM_WEBGBOOKING_STATUS_AWAITING_PAYMENT</option>
            <option value="needs_review">COM_WEBGBOOKING_STATUS_NEEDS_REVIEW</option>
            <option value="expired">COM_WEBGBOOKING_STATUS_EXPIRED</option>
        </field>
        <field
            name="date_from"
            type="calendar"
            label="COM_WEBGBOOKING_FILTER_DATE_FROM"
            format="%Y-%m-%d"
            showtime="false"
            onchange="this.form.submit();"
        />
        <field
            name="date_to"
            type="calendar"
            label="COM_WEBGBOOKING_FILTER_DATE_TO"
            format="%Y-%m-%d"
            showtime="false"
            onchange="this.form.submit();"
        />
    </fields>
    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="booking_date DESC"
            onchange="this.form.submit();"
        >
            <option value="booking_date ASC">COM_WEBGBOOKING_SORT_DATE_ASC</option>
            <option value="booking_date DESC">COM_WEBGBOOKING_SORT_DATE_DESC</option>
            <option value="customer_name ASC">COM_WEBGBOOKING_SORT_NAME_ASC</option>
            <option value="customer_name DESC">COM_WEBGBOOKING_SORT_NAME_DESC</option>
            <option value="status ASC">COM_WEBGBOOKING_SORT_STATUS_ASC</option>
            <option value="status DESC">COM_WEBGBOOKING_SORT_STATUS_DESC</option>
            <option value="created DESC">COM_WEBGBOOKING_SORT_CREATED_DESC</option>
        </field>
        <field
            name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            default="20"
            onchange="this.form.submit();"
        />
    </fields>
</form>
